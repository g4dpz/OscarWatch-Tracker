<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:OscarWatch.Controls"
             xmlns:models="using:OscarWatch.Core.Models"
             xmlns:loc="using:OscarWatch.Localization"
             x:Class="OscarWatch.Controls.HorizonMaskEditorControl"
             x:Name="Root">
  <StackPanel Spacing="8">
    <TextBlock Text="{loc:Localize Key=Settings.Station.HorizonMask}"
               FontWeight="SemiBold" />
    <TextBlock Text="{loc:Localize Key=Settings.Station.HorizonMaskHelp}"
               FontSize="11"
               TextWrapping="Wrap"
               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    <ctrl:HorizonMaskPolarEditControl Height="240"
                                      HorizontalAlignment="Stretch"
                                      Points="{Binding #Root.Points}" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="{loc:Localize Key=Settings.Station.HorizonMaskClear}"
              Click="OnClearClick" />
    </StackPanel>
    <DataGrid ItemsSource="{Binding #Root.Points}"
              AutoGenerateColumns="False"
              IsReadOnly="False"
              MaxHeight="160"
              HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{loc:Localize Key=Settings.Station.HorizonMaskAz}"
                            Width="*"
                            x:DataType="models:HorizonMaskPoint"
                            Binding="{Binding AzimuthDeg, Mode=TwoWay}" />
        <DataGridTextColumn Header="{loc:Localize Key=Settings.Station.HorizonMaskEl}"
                            Width="*"
                            x:DataType="models:HorizonMaskPoint"
                            Binding="{Binding ElevationDeg, Mode=TwoWay}" />
      </DataGrid.Columns>
    </DataGrid>
  </StackPanel>
</UserControl>
