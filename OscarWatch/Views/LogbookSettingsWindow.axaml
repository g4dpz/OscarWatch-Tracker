<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OscarWatch.ViewModels"
        xmlns:models="using:OscarWatch.Core.Models"
        xmlns:loc="using:OscarWatch.Localization"
        x:Class="OscarWatch.Views.LogbookSettingsWindow"
        x:DataType="vm:LogbookSettingsViewModel"
        Title="{loc:Localize Key=Window.LogbookSettings.Title}"
        Width="520"
        SizeToContent="Height"
        MinWidth="480"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,16,0,0">
      <TextBlock Text="{Binding ErrorText}"
                 TextWrapping="Wrap"
                 Foreground="#FFC07070"
                 IsVisible="{Binding HasError}" />
      <TextBlock Text="{Binding StatusText}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                 IsVisible="{Binding HasStatus}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="{loc:Localize Key=Common.Cancel}"
                Classes="dialog-footer"
                Click="OnCancelClick"
                IsCancel="True" />
        <Button Content="{loc:Localize Key=Common.Save}"
                Classes="dialog-footer accent"
                Click="OnSaveClick"
                IsDefault="True"
                IsEnabled="{Binding CanSaveStationProfile}" />
      </StackPanel>
    </StackPanel>

    <TabControl Margin="0,0,0,4">
      <TabControl.Styles>
        <Style Selector="TabItem">
          <Setter Property="FontSize" Value="14" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style Selector="TabItem TextBlock">
          <Setter Property="FontSize" Value="14" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TabItem ScrollViewer StackPanel > TextBlock">
          <Setter Property="FontSize" Value="12" />
          <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="TabItem ScrollViewer > TextBlock">
          <Setter Property="FontSize" Value="11" />
          <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="TabItem ScrollViewer > StackPanel">
          <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
      </TabControl.Styles>
      <TabItem Header="{loc:Localize Key=Settings.Tab.Cloudlog}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,4,0">
          <StackPanel Spacing="14" MaxWidth="480">
            <TextBlock Text="{loc:Localize Key=Settings.Cloudlog.Section}"
                       FontWeight="SemiBold"
                       FontSize="13" />
            <TextBlock Text="{loc:Localize Key=Logbook.Settings.Cloudlog.Intro}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Localize Key=Logbook.Settings.Cloudlog.UrlLabel}" />
              <TextBox Text="{Binding CloudlogUrlSummary}"
                       IsReadOnly="True" />
              <TextBlock Text="{loc:Localize Key=Logbook.Settings.Cloudlog.UrlNote}"
                         TextWrapping="Wrap"
                         FontSize="11"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>
            <CheckBox Content="{loc:Localize Key=Logbook.Settings.Cloudlog.AutoUpload}"
                      IsChecked="{Binding CloudlogAutoUpload, Mode=TwoWay}"
                      IsEnabled="{Binding CloudlogConfigured}" />
            <StackPanel Spacing="4" IsEnabled="{Binding CloudlogConfigured}">
              <TextBlock Text="{loc:Localize Key=Logbook.Settings.Cloudlog.StationProfile}" />
              <Grid ColumnDefinitions="*,Auto">
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding StationProfiles}"
                          SelectedItem="{Binding SelectedStationProfile, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"
                          IsEnabled="{Binding !IsLoadingProfiles}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="models:CloudlogStationProfile">
                      <TextBlock Text="{Binding DisplayLabel}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="{loc:Localize Key=Logbook.Settings.Cloudlog.RefreshProfiles}"
                        Command="{Binding RefreshStationProfilesCommand}"
                        IsEnabled="{Binding !IsLoadingProfiles}" />
              </Grid>
              <TextBlock Text="{loc:Localize Key=Logbook.Settings.Cloudlog.StationProfileNote}"
                         TextWrapping="Wrap"
                         FontSize="11"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>
            <Button Content="{loc:Localize Key=Logbook.Settings.Cloudlog.RetryFailed}"
                    Command="{Binding RetryFailedUploadsCommand}"
                    HorizontalAlignment="Left"
                    IsEnabled="{Binding CloudlogConfigured}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{loc:Localize Key=Settings.Tab.Qrz}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,4,0">
          <StackPanel Spacing="14" MaxWidth="480">
            <TextBlock Text="{loc:Localize Key=Settings.Qrz.Section}"
                       FontWeight="SemiBold"
                       FontSize="13" />
            <TextBlock Text="{loc:Localize Key=Logbook.Settings.Qrz.Intro}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <CheckBox Content="{loc:Localize Key=Settings.Qrz.Enable}"
                      IsChecked="{Binding QrzEnabled, Mode=TwoWay}" />
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Localize Key=Settings.Qrz.Username}" />
              <TextBox Text="{Binding QrzUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       Watermark="{loc:Localize Key=Settings.Qrz.UsernameWatermark}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Localize Key=Settings.Qrz.Password}" />
              <TextBox Text="{Binding QrzPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PasswordChar="•"
                       Watermark="{loc:Localize Key=Settings.Qrz.PasswordWatermark}" />
            </StackPanel>
            <TextBlock Text="{loc:Localize Key=Logbook.Settings.Qrz.CredentialsNote}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Button Content="{loc:Localize Key=Settings.Qrz.TestConnection}"
                    Command="{Binding TestQrzCommand}"
                    HorizontalAlignment="Left" />
            <TextBlock Text="{Binding QrzTestStatus}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       MinHeight="20"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       IsVisible="{Binding HasQrzStatus}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{loc:Localize Key=Settings.Tab.HamQth}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,4,0">
          <StackPanel Spacing="14" MaxWidth="480">
            <TextBlock Text="{loc:Localize Key=Settings.HamQth.Section}"
                       FontWeight="SemiBold"
                       FontSize="13" />
            <TextBlock Text="{loc:Localize Key=Logbook.Settings.HamQth.Intro}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <CheckBox Content="{loc:Localize Key=Settings.HamQth.Enable}"
                      IsChecked="{Binding HamQthEnabled, Mode=TwoWay}" />
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Localize Key=Settings.HamQth.Username}" />
              <TextBox Text="{Binding HamQthUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       Watermark="{loc:Localize Key=Settings.HamQth.UsernameWatermark}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Localize Key=Settings.HamQth.Password}" />
              <TextBox Text="{Binding HamQthPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PasswordChar="•"
                       Watermark="{loc:Localize Key=Settings.HamQth.PasswordWatermark}" />
            </StackPanel>
            <TextBlock Text="{loc:Localize Key=Logbook.Settings.HamQth.CredentialsNote}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Button Content="{loc:Localize Key=Settings.HamQth.TestConnection}"
                    Command="{Binding TestHamQthCommand}"
                    HorizontalAlignment="Left" />
            <TextBlock Text="{Binding HamQthTestStatus}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       MinHeight="20"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       IsVisible="{Binding HasHamQthStatus}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
