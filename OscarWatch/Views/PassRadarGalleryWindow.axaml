<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OscarWatch.ViewModels"
        xmlns:loc="using:OscarWatch.Localization"
        xmlns:ctrl="using:OscarWatch.Controls"
        x:Class="OscarWatch.Views.PassRadarGalleryWindow"
        x:DataType="vm:PassRadarGalleryViewModel"
        Title="{loc:Localize Key=Window.PassRadarGallery.Title}"
        Width="960"
        Height="640"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="14"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="12"
        x:Name="ScreenshotRoot">
    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock Text="{Binding HeadingText}"
                 FontSize="18"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap" />
      <TextBlock Text="{Binding SubtitleText}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PassRadarCardViewModel">
            <Border Height="312"
                    Margin="6"
                    Padding="10"
                    HorizontalAlignment="Stretch"
                    CornerRadius="6"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1">
              <Grid RowDefinitions="Auto,Auto,Auto,*"
                    RowSpacing="4">
                <TextBlock Grid.Row="0"
                           Text="{Binding TitleText}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="1"
                           Text="{Binding TimeText}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
                <TextBlock Grid.Row="2"
                           Text="{Binding StatsText}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                <ctrl:PassPolarPlotControl Grid.Row="3"
                                           PlotData="{Binding PlotData}"
                                           MinimumElevationDeg="{Binding MinimumElevationDeg}"
                                           HorizonMask="{Binding HorizonMask}"
                                           UseUtcTime="{Binding UseUtcTime}"
                                           Use24HourClock="{Binding Use24HourClock}"
                                           Margin="0,4,0,0"
                                           MinHeight="180"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="2"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,0"
            Padding="0,12,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="16"
                    VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border Width="22" Height="3" Background="#D4A017" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Localize Key=Mutual.Visualizer.Legend.Sunlit}"
                       FontSize="11"
                       VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border Width="22" Height="3" Background="#E05252" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Localize Key=Mutual.Visualizer.Legend.Eclipse}"
                       FontSize="11"
                       VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="{loc:Localize Key=Mutual.Visualizer.Screenshot}"
                  Click="OnScreenshotClick"
                  MinWidth="100" />
          <Button Content="{loc:Localize Key=Common.Close}"
                  Click="OnCloseClick"
                  MinWidth="80" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
